# ============================================================
# Ordre de Mission — Variables d'environnement
# Copiez ce fichier vers .env ou exportez avant de lancer l'application
# Ne commitez jamais le fichier .env reel avec des secrets
# ============================================================

# Base de donnees
DB_URL=jdbc:mysql://localhost:3306/mission_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=mission_app
DB_PASSWORD=<votre-mot-de-passe-mysql-fort>

# Application
PORT=8080
PORTAL_BASE_URL=http://localhost:8080

# JPA (mettre "validate" en production, "update" en dev)
JPA_DDL_AUTO=update

# Thymeleaf (mettre "true" en production)
THYMELEAF_CACHE=false

# Logs (mettre "INFO" ou "WARN" en production)
LOG_SECURITY=DEBUG
LOG_WEB=DEBUG

# Mail SMTP (optionnel — vide = notifications journalisees, application continue)
# Exemple Gmail :
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=<votre-adresse-gmail>
MAIL_PASSWORD=<votre-mot-de-passe-application-gmail>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
